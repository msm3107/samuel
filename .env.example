# Copy to .env.local and fill in. Never put real credentials in this file.

NEXT_PUBLIC_APP_URL=http://localhost:3000

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_FOUNDER=
STRIPE_PRICE_AGENCY=
STRIPE_PRICE_AGENCY_PRO=

# Authenticates Vercel Cron calls to the verification endpoint. At least 32
# characters; generate with: openssl rand -base64 48
CRON_SECRET=

SENTRY_DSN=

# trace | debug | info | warn | error | fatal — defaults to info
LOG_LEVEL=

# Copy to .env.local and fill in. Never put real credentials in this file.

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Locally, `node scripts/local-env.mjs --write` fills these from `supabase status`.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_FOUNDER=
STRIPE_PRICE_AGENCY=
STRIPE_PRICE_AGENCY_PRO=

# Authenticates Vercel Cron calls to the verification endpoint. At least 32
# characters; generate with: openssl rand -base64 48
CRON_SECRET=

# Keys the sign-in rate-limit buckets, so the database never holds an email or
# IP address. At least 32 characters; generate with: openssl rand -base64 48
RATE_LIMIT_HMAC_SECRET=

# Cloudflare Turnstile, shown on sign-in only under unusual load. Locally, use
# Cloudflare's always-pass test keys: 1x00000000000000000000AA (site) and
# 1x0000000000000000000000000000000AA (secret). Production refuses them.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

SENTRY_DSN=

# trace | debug | info | warn | error | fatal — defaults to info
LOG_LEVEL=
